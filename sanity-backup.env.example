# sanity-backup.env — one file per Sanity project.
# Copy to e.g. /etc/sanity-backup/client-a.env and `chmod 600` it (contains secrets).

# --- Sanity ---------------------------------------------------------------
SANITY_PROJECT_ID="abc123xy"
# Create in sanity.io/manage → API → Tokens. "Viewer" is enough for exports.
SANITY_AUTH_TOKEN="sk..."
# Space-separated list of datasets to back up
SANITY_DATASETS="production"
# Extra flags for `sanity dataset export`, e.g. "--no-drafts" or "--mode cursor"
SANITY_EXPORT_FLAGS=""
# npm version of @sanity/cli used via npx. Pin it (e.g. "8") so a CLI release
# can't silently break backups. Ignored in the Docker image (CLI is preinstalled).
SANITY_CLI_VERSION="latest"
# Folder name in S3 + name for logs/locks. Defaults to the project ID.
BACKUP_NAME="client-a"

# --- S3 -------------------------------------------------------------------
S3_BUCKET="my-backups"
S3_PREFIX="sanity-backups"
# Leave empty for AWS. Examples:
#   Hetzner:  https://fsn1.your-objectstorage.com
#   R2:       https://<account-id>.r2.cloudflarestorage.com
#   Scaleway: https://s3.fr-par.scw.cloud
S3_ENDPOINT_URL=""
S3_STORAGE_CLASS=""

# Credentials for the aws CLI (alternatively use `aws configure` / an AWS profile)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="eu-central-1"
# AWS_PROFILE="backups"

# Or use rclone instead of the aws CLI:
# UPLOAD_TOOL="rclone"
# RCLONE_REMOTE="hetzner"

# --- Heartbeat (optional — leave empty to skip) ---------------------------
# healthchecks.io: https://hc-ping.com/<uuid>
# Better Stack:    https://uptime.betterstack.com/api/v1/heartbeat/<token>
HEARTBEAT_URL=""
# "true" pings URL/start before the run (healthchecks.io measures duration).
# Better Stack has no /start endpoint → keep "false".
HEARTBEAT_SEND_START="false"

# --- Local ----------------------------------------------------------------
WORK_DIR="/var/tmp/sanity-backup"
# Keep the newest N exports locally as well (0 = delete right after upload)
KEEP_LOCAL_COPIES="0"
# Append logs to $LOG_DIR/<BACKUP_NAME>.log (empty = stdout only, e.g. in Docker)
LOG_DIR="/var/log/sanity-backup"
# Timezone for the timestamp in file names
TZ_NAME="Europe/Berlin"
